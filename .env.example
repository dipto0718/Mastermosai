# Copy to .env.local and fill in. Everything is optional: with nothing set the app runs in demo mode as guest-only.

# Real Akash Master and Little Master. Without it: demo mode with scripted personas.
ANTHROPIC_API_KEY=

# Accounts and server-side memory. Without them: guest mode only (data stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional overrides (defaults shown)
# AKASH_MASTER_MODEL=claude-opus-5-5
# AKASH_MASTER_EFFORT=high
# LITTLE_MASTER_MODEL=claude-opus-5-5
# LITTLE_MASTER_EFFORT=low
# MASTERMOSAI_DEMO_MODE=0
# MASTERMOSAI_REFUSAL_FALLBACK=on   # set to "off" to disable the automatic refusal fallback

# Mastermosai is free for every student. Optional fair-use cap on classes per signed-in student per day (0 = unlimited).
# FAIR_USE_DAILY_TURNS=0
